    "eps": 1e-8,
    "scheduler": "type1",
    "grad_clip_norm": null,
    "batch_size": 32,
    "max_epochs": 10,
    "patience": 3
  },
  "training_source": {
    "kind": "upstream",
    "links": [
      "https://github.com/YoZhibo/MSGNet/blob/main/scripts/ETTh1.sh",
      "https://github.com/YoZhibo/MSGNet/blob/main/run_longExp.py",
      "https://github.com/YoZhibo/MSGNet/blob/main/exp/exp_main.py",
      "https://github.com/YoZhibo/MSGNet/blob/main/utils/tools.py"
    ]
  }
}
